# Optional deployment label for deployment-specific behavior.
APP_ENV=development

# Public origin serving this dashboard. Set this behind a reverse proxy so
# same-origin mutation protection compares against the browser-facing URL.
DASHBOARD_ORIGIN=https://admin.example.com

# Server-only public website origin used for Pages public and Preview links.
PUBLIC_FRONTEND_ORIGIN=https://www.example.com

# Valid values: debug, info, warn, error.
LOG_LEVEL=info

# Server-only secret for deployments that sign session payloads.
SESSION_SECRET=replace-with-a-long-random-secret

# Server-side session limits. Both values must be positive whole numbers.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Required before the server API client makes requests. This value remains
# server-only and must not use a NEXT_PUBLIC_ prefix.
BACKEND_API_URL=https://cms.dwam-tech.com

# Shared modules default to true so existing deployments keep their current
# navigation. Set them to false per deployment without deleting shared pages.
DASHBOARD_MODULE_ARTICLES_ENABLED=true
DASHBOARD_MODULE_SECTIONS_ENABLED=true
DASHBOARD_MODULE_GOVERNANCE_ENABLED=true
DASHBOARD_MODULE_PROGRAMS_ENABLED=true
DASHBOARD_MODULE_APPLICATIONS_ENABLED=true
DASHBOARD_MODULE_FEEDBACK_ENABLED=true
DASHBOARD_MODULE_GALLERY_MEDIA_ENABLED=true
DASHBOARD_MODULE_LEGACY_VISUALS_ENABLED=true

# Optional site modules. Keep false in the shared template and enable only for
# deployments that have the matching backend module and permissions.
DASHBOARD_MODULE_LIBRARY_ENABLED=false
DASHBOARD_MODULE_DISSERTATIONS_ENABLED=false
DASHBOARD_MODULE_LISTENING_ENABLED=false
DASHBOARD_MODULE_HADITH_CARDS_ENABLED=false
DASHBOARD_MODULE_SCIENTIFIC_FATWAS_ENABLED=false
DASHBOARD_MODULE_SCIENTIFIC_VIDEOS_ENABLED=false
DASHBOARD_MODULE_LIBRARY_INDEXES_ENABLED=false
DASHBOARD_MODULE_COMMENTS_ENABLED=false
DASHBOARD_MODULE_TOUR_GUIDES_ENABLED=false

# Public, non-sensitive display name. This is bundled at build time by Next.js.
NEXT_PUBLIC_APP_NAME=CMS Dashboard
NEXT_PUBLIC_APP_SHORT_NAME=CMS
NEXT_PUBLIC_APP_DESCRIPTION=Reusable CMS dashboard infrastructure.
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_LANGUAGE=ar
NEXT_PUBLIC_APP_DIRECTION=rtl

# Public brand assets. Use project-root paths inside /public.
NEXT_PUBLIC_BRAND_LOGO=/branding/logo.svg
NEXT_PUBLIC_BRAND_DARK_LOGO=/branding/logo-dark.svg
NEXT_PUBLIC_BRAND_MARK=/branding/dashboard-mark.svg
NEXT_PUBLIC_LOGIN_SHOWCASE_TITLE=لوحة تحكم وإدارة موقع جمعية مبتكرون
NEXT_PUBLIC_LOGIN_SHOWCASE_LOGO=/logo.png

# Supported values: cairo-montserrat, cairo, montserrat.
NEXT_PUBLIC_FONT_PRESET=cairo-montserrat

# Public technical-support contact shown in the sidebar.
# WhatsApp uses the international number without a leading plus sign.
NEXT_PUBLIC_SUPPORT_PHONE=015558558579
NEXT_PUBLIC_SUPPORT_WHATSAPP=2015558558579

# Core brand palette. These values are validated as six-digit HEX colors.
THEME_COLOR_GOLD="#D9BB5D"
THEME_COLOR_BROWN="#937133"
THEME_COLOR_DARK_TEAL="#2B393A"
THEME_COLOR_TEAL="#1B3A36"
THEME_COLOR_GREEN="#156D54"
THEME_COLOR_DARK_GREEN="#01231C"

# Arabic dashboard navigation and entity labels.
# Technical routes and permission keys remain fixed in source code.
NEXT_PUBLIC_NAV_DASHBOARD=لوحة التحكم
NEXT_PUBLIC_NAV_ACCOUNT=إدارة الحساب

# Deployment-specific labels for the public-site modules. Each value is
# reused in the sidebar, page hero, metadata, breadcrumbs, and settings cards.
NEXT_PUBLIC_DASHBOARD_MODULE_ARTICLES_LABEL=المقالات والدراسات
NEXT_PUBLIC_DASHBOARD_MODULE_LIBRARY_LABEL=المصنَّفات والمكتبة الرقمية
NEXT_PUBLIC_DASHBOARD_MODULE_DISSERTATIONS_LABEL=الإنتاج الأكاديمي والإشراف العلمي
NEXT_PUBLIC_DASHBOARD_MODULE_LISTENING_LABEL=مجالس السماع والمواد الصوتية
NEXT_PUBLIC_DASHBOARD_MODULE_HADITH_CARDS_LABEL=البطاقات الحديثية
NEXT_PUBLIC_DASHBOARD_MODULE_SCIENTIFIC_FATWAS_LABEL=الفتاوى والمسائل الحديثة
NEXT_PUBLIC_DASHBOARD_MODULE_SCIENTIFIC_VIDEOS_LABEL=المرئيات واللقاءات العلمية
NEXT_PUBLIC_DASHBOARD_MODULE_LIBRARY_INDEXES_LABEL=فهارس المكتبة وسجلات الزوار
NEXT_PUBLIC_DASHBOARD_MODULE_COMMENTS_LABEL=إدارة التعليقات

NEXT_PUBLIC_NAV_SECTIONS=إدارة الأقسام
NEXT_PUBLIC_ENTITY_SECTION_SINGULAR=القسم
NEXT_PUBLIC_ENTITY_SECTION_PLURAL=الأقسام

NEXT_PUBLIC_NAV_ARTICLES=إدارة المقالات
NEXT_PUBLIC_ENTITY_ARTICLE_SINGULAR=المقال
NEXT_PUBLIC_ENTITY_ARTICLE_PLURAL=المقالات

NEXT_PUBLIC_NAV_BOOKS=إدارة الكتب
NEXT_PUBLIC_ENTITY_BOOK_SINGULAR=الكتاب
NEXT_PUBLIC_ENTITY_BOOK_PLURAL=الكتب
NEXT_PUBLIC_ENTITY_BOOK_SERIES_SINGULAR=السلسلة
NEXT_PUBLIC_ENTITY_BOOK_SERIES_PLURAL=السلاسل

NEXT_PUBLIC_NAV_VISUALS=إدارة المرئيات
NEXT_PUBLIC_ENTITY_VISUAL_SINGULAR=المرئية
NEXT_PUBLIC_ENTITY_VISUAL_PLURAL=المرئيات

NEXT_PUBLIC_NAV_GALLERY=إدارة معرض الوسائط
NEXT_PUBLIC_ENTITY_MEDIA_SINGULAR=الوسيط
NEXT_PUBLIC_ENTITY_MEDIA_PLURAL=الوسائط

NEXT_PUBLIC_NAV_SUPERVISORS=إدارة المشرفين
NEXT_PUBLIC_ENTITY_SUPERVISOR_SINGULAR=المشرف
NEXT_PUBLIC_ENTITY_SUPERVISOR_PLURAL=المشرفون

NEXT_PUBLIC_NAV_REPORTS=التقارير والتحليلات
NEXT_PUBLIC_ENTITY_REPORT_SINGULAR=التقرير
NEXT_PUBLIC_ENTITY_REPORT_PLURAL=التقارير

NEXT_PUBLIC_NAV_SETTINGS=إدارة الإعدادات
NEXT_PUBLIC_ENTITY_SETTING_SINGULAR=الإعداد
NEXT_PUBLIC_ENTITY_SETTING_PLURAL=الإعدادات

# Optional Arabic grammar overrides. Omit them to derive titles automatically
# from the singular entity labels. The same CREATE/EDIT/DETAIL pattern is
# supported for SECTIONS, ARTICLES, BOOKS, VISUALS, GALLERY, SUPERVISORS,
# and SETTINGS.
# NEXT_PUBLIC_PAGE_BOOKS_CREATE_TITLE=إضافة كتاب جديد
# NEXT_PUBLIC_PAGE_BOOKS_EDIT_TITLE=تعديل بيانات الكتاب
# NEXT_PUBLIC_PAGE_BOOKS_DETAIL_TITLE=تفاصيل الكتاب
